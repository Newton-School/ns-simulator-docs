{
  "id": "sensor-gamed",
  "name": "Sensor store (gamed: relational DB)",
  "version": "1.0.0",
  "global": {
    "simulationDuration": 30000,
    "warmupDuration": 5000,
    "seed": "sensor-gamed",
    "timeResolution": "millisecond",
    "defaultTimeout": 5000
  },
  "nodes": [
    {
      "id": "client",
      "type": "api-endpoint",
      "category": "compute",
      "label": "Client",
      "position": {
        "x": 0,
        "y": 90
      },
      "queue": {
        "workers": 500,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "m5.large",
        "instanceCount": 1,
        "workloadKind": "io-bound",
        "workersPerInstance": 500,
        "queueSlots": 99500,
        "perRequestMemMb": 0.04096
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 0.1
        },
        "timeout": 5000
      }
    },
    {
      "id": "svc",
      "type": "microservice",
      "category": "compute",
      "label": "svc",
      "position": {
        "x": 0,
        "y": 180
      },
      "queue": {
        "workers": 80,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "c5.large",
        "instanceCount": 1,
        "workloadKind": "io-bound",
        "workersPerInstance": 80,
        "queueSlots": 99920,
        "perRequestMemMb": 0.02048
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 1
        },
        "timeout": 5000
      }
    },
    {
      "id": "db",
      "type": "relational-db",
      "category": "storage-and-data",
      "label": "db",
      "position": {
        "x": 0,
        "y": 270
      },
      "queue": {
        "workers": 50,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "t3.small",
        "instanceCount": 1,
        "workloadKind": "cpu-bound",
        "workersPerInstance": 50,
        "queueSlots": 99950,
        "perRequestMemMb": 0.08192
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 3
        },
        "timeout": 5000
      }
    }
  ],
  "edges": [
    {
      "id": "e-client-svc",
      "source": "client",
      "target": "svc",
      "mode": "synchronous",
      "protocol": "tcp",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 1000,
      "maxConcurrentRequests": 50000,
      "packetLossRate": 0,
      "errorRate": 0
    },
    {
      "id": "e-svc-db",
      "source": "svc",
      "target": "db",
      "mode": "synchronous",
      "protocol": "tcp",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 1000,
      "maxConcurrentRequests": 50000,
      "packetLossRate": 0,
      "errorRate": 0
    }
  ],
  "workload": {
    "sourceNodeId": "client",
    "pattern": "constant",
    "baseRps": 3000,
    "requestDistribution": [
      {
        "type": "ingest",
        "weight": 0.95,
        "sizeBytes": 256
      },
      {
        "type": "read",
        "weight": 0.05,
        "sizeBytes": 256
      }
    ]
  }
}
