{
  "id": "stream-v2-gamed",
  "name": "Stream V2 Lifecycle Gamed",
  "version": "1.0.0",
  "global": {
    "simulationDuration": 1000,
    "warmupDuration": 0,
    "seed": "stream-v2-gamed",
    "timeResolution": "millisecond",
    "defaultTimeout": 5000
  },
  "nodes": [
    {
      "id": "orders-api",
      "type": "api-endpoint",
      "category": "compute",
      "role": "source",
      "label": "Orders API",
      "position": { "x": 0, "y": 120 },
      "queue": { "workers": 200, "capacity": 10000, "discipline": "fifo" },
      "processing": { "distribution": { "type": "constant", "value": 0.2 }, "timeout": 5000 }
    },
    {
      "id": "orders-stream",
      "type": "stream",
      "category": "messaging-and-streaming",
      "role": "processor",
      "label": "Orders Stream Without Broker Semantics",
      "position": { "x": 260, "y": 120 },
      "queue": { "workers": 200, "capacity": 10000, "discipline": "fifo" },
      "processing": { "distribution": { "type": "constant", "value": 0.2 }, "timeout": 5000 },
      "config": {
        "streamBrokerEnabled": false
      }
    },
    {
      "id": "shared-worker",
      "type": "batch-worker",
      "category": "compute",
      "role": "processor",
      "label": "Shared Worker",
      "position": { "x": 540, "y": 120 },
      "queue": { "workers": 200, "capacity": 10000, "discipline": "fifo" },
      "processing": { "distribution": { "type": "constant", "value": 1 }, "timeout": 5000 }
    }
  ],
  "edges": [
    {
      "id": "api-to-stream",
      "source": "orders-api",
      "target": "orders-stream",
      "mode": "asynchronous",
      "protocol": "tcp",
      "latency": { "distribution": { "type": "constant", "value": 0.2 }, "pathType": "same-dc" },
      "bandwidth": 1000,
      "maxConcurrentRequests": 10000,
      "packetLossRate": 0,
      "errorRate": 0
    },
    {
      "id": "stream-to-worker",
      "source": "orders-stream",
      "target": "shared-worker",
      "mode": "asynchronous",
      "protocol": "tcp",
      "latency": { "distribution": { "type": "constant", "value": 0.2 }, "pathType": "same-dc" },
      "bandwidth": 1000,
      "maxConcurrentRequests": 10000,
      "packetLossRate": 0,
      "errorRate": 0
    }
  ],
  "workload": {
    "sourceNodeId": "orders-api",
    "pattern": "constant",
    "baseRps": 500,
    "requestDistribution": [
      {
        "type": "POST",
        "weight": 1,
        "sizeBytes": 512,
        "metadata": {
          "partitionKey": "tenant-a"
        }
      }
    ]
  },
  "faults": [],
  "invariants": [],
  "scenarios": []
}
