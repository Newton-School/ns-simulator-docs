{
  "id": "url-ref",
  "name": "URL shortener (reference)",
  "version": "1.0.0",
  "global": {
    "simulationDuration": 30000,
    "warmupDuration": 5000,
    "seed": "url-ref",
    "timeResolution": "millisecond",
    "defaultTimeout": 5000
  },
  "nodes": [
    {
      "id": "client",
      "type": "api-endpoint",
      "category": "compute",
      "label": "Client",
      "position": {
        "x": 0,
        "y": 90
      },
      "queue": {
        "workers": 500,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "m5.large",
        "instanceCount": 1,
        "workloadKind": "io-bound",
        "workersPerInstance": 500,
        "queueSlots": 99500,
        "perRequestMemMb": 0.04096
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 0.1
        },
        "timeout": 5000
      }
    },
    {
      "id": "lb",
      "type": "load-balancer",
      "category": "network-and-edge",
      "label": "lb",
      "position": {
        "x": 0,
        "y": 90
      },
      "queue": {
        "workers": 300,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "m5.large",
        "instanceCount": 1,
        "workloadKind": "io-bound",
        "workersPerInstance": 300,
        "queueSlots": 99700,
        "perRequestMemMb": 0.04096
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 1
        },
        "timeout": 5000
      }
    },
    {
      "id": "svc",
      "type": "microservice",
      "category": "compute",
      "label": "svc",
      "position": {
        "x": 0,
        "y": 180
      },
      "queue": {
        "workers": 80,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "c5.large",
        "instanceCount": 1,
        "workloadKind": "io-bound",
        "workersPerInstance": 80,
        "queueSlots": 99920,
        "perRequestMemMb": 0.02048
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 2
        },
        "timeout": 5000
      }
    },
    {
      "id": "cache",
      "type": "in-memory-cache",
      "category": "storage-and-data",
      "label": "cache",
      "position": {
        "x": 0,
        "y": 270
      },
      "queue": {
        "workers": 1000,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "r5.large",
        "instanceCount": 1,
        "workloadKind": "io-bound",
        "workersPerInstance": 1000,
        "queueSlots": 99000,
        "perRequestMemMb": 0.08192
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 1
        },
        "timeout": 5000
      },
      "config": {
        "cacheHitRate": 0.9,
        "cacheHitLatencyMs": 1
      }
    },
    {
      "id": "store",
      "type": "kv-store",
      "category": "storage-and-data",
      "label": "store",
      "position": {
        "x": 0,
        "y": 360
      },
      "queue": {
        "workers": 50,
        "capacity": 100000,
        "discipline": "fifo"
      },
      "resources": {
        "instanceType": "t3.small",
        "instanceCount": 1,
        "workloadKind": "cpu-bound",
        "workersPerInstance": 50,
        "queueSlots": 99950,
        "perRequestMemMb": 0.04096
      },
      "processing": {
        "distribution": {
          "type": "constant",
          "value": 3
        },
        "timeout": 5000
      }
    }
  ],
  "edges": [
    {
      "id": "e-client-lb",
      "source": "client",
      "target": "lb",
      "mode": "synchronous",
      "protocol": "tcp",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 1000,
      "maxConcurrentRequests": 50000,
      "packetLossRate": 0,
      "errorRate": 0
    },
    {
      "id": "e-lb-svc",
      "source": "lb",
      "target": "svc",
      "mode": "synchronous",
      "protocol": "tcp",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 1000,
      "maxConcurrentRequests": 50000,
      "packetLossRate": 0,
      "errorRate": 0
    },
    {
      "id": "e-svc-cache",
      "source": "svc",
      "target": "cache",
      "mode": "conditional",
      "condition": "request.type === \"read\"",
      "protocol": "tcp",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 1000,
      "maxConcurrentRequests": 50000,
      "packetLossRate": 0,
      "errorRate": 0
    },
    {
      "id": "e-svc-store",
      "source": "svc",
      "target": "store",
      "mode": "conditional",
      "condition": "request.type === \"write\"",
      "protocol": "tcp",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 1000,
      "maxConcurrentRequests": 50000,
      "packetLossRate": 0,
      "errorRate": 0
    },
    {
      "id": "e-cache-store",
      "source": "cache",
      "target": "store",
      "mode": "synchronous",
      "protocol": "tcp",
      "latency": {
        "distribution": {
          "type": "constant",
          "value": 0.5
        },
        "pathType": "same-dc"
      },
      "bandwidth": 1000,
      "maxConcurrentRequests": 50000,
      "packetLossRate": 0,
      "errorRate": 0
    }
  ],
  "workload": {
    "sourceNodeId": "client",
    "pattern": "constant",
    "baseRps": 2000,
    "requestDistribution": [
      {
        "type": "read",
        "weight": 0.99,
        "sizeBytes": 256
      },
      {
        "type": "write",
        "weight": 0.01,
        "sizeBytes": 512
      }
    ]
  }
}
